---
import { render } from 'astro:content';

interface Props {
  recipes: Array<any>;
}

const { recipes } = Astro.props;

const renderedRecipes = await Promise.all(
  recipes.map(async (r) => {
    const { Content } = await render(r);
    return { ...r, Content };
  })
);
---
<div class="win hidden" id="w-recipes" style="left:520px; top:70px; width:720px; height:480px; z-index:23;">
  <div class="tb">
    <svg viewBox="0 0 16 16"><rect x="2" y="6" width="12" height="8" fill="#ff9933" stroke="#000"/><line x1="1" y1="6" x2="15" y2="6" stroke="#000" stroke-width="2"/></svg>
    <span class="t-label">(Secret...Recipes) — /home/lucas/recipes</span>
    <div class="btns"><button data-min>▁</button><button data-max>□</button><button data-close>✕</button></div>
  </div>
  <div class="menubar">
    <span><u>F</u>ile</span>
    <span><u>V</u>iew</span>
    <span id="recipeResetBtn"><u>A</u>ll Recipes</span>
  </div>
  <div class="body" id="recipesBody">
    <div id="recipesListWrap">
      <table class="filelist">
        <thead>
          <tr><th>Recipe</th><th>Time / Method</th><th>Summary</th></tr>
        </thead>
        <tbody>
          {recipes.map((recipe) => (
            <tr data-recipe={recipe.data.slug}>
              <td>
                <b>{recipe.data.title}</b>
                {recipe.data.recipeTag && <span class="tag">{recipe.data.recipeTag}</span>}
              </td>
              <td>{recipe.data.recipeTime}</td>
              <td>{recipe.data.summary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div id="recipeDetailWrap" style="display:none">
      {renderedRecipes.map(({ data, Content }) => (
        <div class="r-box" data-recipe-detail={data.slug} style="display:none">
          <div class="r-head">
            <div>
              <h4>
                {data.title}
                {data.recipeTag && <span class="tag">{data.recipeTag}</span>}
              </h4>
              <div class="r-meta">{data.recipeTime} · /home/lucas/recipes/{data.slug}.md</div>
            </div>
            <div class="r-actions">
              <button class="p-btn" data-recipe-back type="button">← All Recipes</button>
              <a class="p-btn" href={`/${data.slug}.html`} data-nav={`/${data.slug}.html`}>↗ Viewer</a>
            </div>
          </div>
          <div class="prose r-prose">
            <Content />
          </div>
          <div class="r-foot">
            <button class="p-btn" data-recipe-back type="button">← All Recipes</button>
            <a class="p-btn" href={`/${data.slug}.html`} data-nav={`/${data.slug}.html`}>↗ Open in Workspace 2 Viewer</a>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="status"><span>{recipes.length} recipes</span><span>/home/lucas/recipes</span></div>
</div>
