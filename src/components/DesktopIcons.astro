---
// Desktop Icons Rail + Secret Recipes Icon
---
<div class="desktop" id="desk">
  <div class="d-icon" data-open="about">
    <div class="glyph">
      <svg viewBox="0 0 32 32">
        <rect x="4" y="4" width="24" height="17" fill="#c0c0c0" stroke="#000" stroke-width="1.5"></rect>
        <rect x="6" y="6" width="20" height="13" fill="#183661"></rect>
        <circle cx="16" cy="11" r="3" fill="#ffff55"></circle>
        <path d="M10 18c1-3 11-3 12 0" fill="#33ff78"></path>
        <rect x="6" y="23" width="20" height="5" fill="#c0c0c0" stroke="#000" stroke-width="1.5"></rect>
      </svg>
    </div>
    <span>About Me</span>
  </div>

  <div class="d-icon" data-open="projects">
    <div class="glyph">
      <svg viewBox="0 0 32 32">
        <path d="M3 8h10l2 3h14v16H3Z" fill="#ffff55" stroke="#000" stroke-width="1.5"></path>
        <path d="M3 12h26v15H3Z" fill="#ffcc00" stroke="#000" stroke-width="1.5"></path>
      </svg>
    </div>
    <span>Projects</span>
  </div>

  <div class="d-icon" data-open="blog">
    <div class="glyph">
      <svg viewBox="0 0 32 32">
        <rect x="6" y="3" width="20" height="26" fill="#e6edf7" stroke="#000" stroke-width="1.5"></rect>
        <rect x="6" y="3" width="20" height="5" fill="#183661"></rect>
        <line x1="9" y1="12" x2="23" y2="12" stroke="#000" stroke-width="1.5"></line>
        <line x1="9" y1="16" x2="23" y2="16" stroke="#000" stroke-width="1.5"></line>
        <line x1="9" y1="20" x2="18" y2="20" stroke="#000" stroke-width="1.5"></line>
      </svg>
    </div>
    <span>Blog</span>
  </div>

  <div class="d-icon" data-open="models">
    <div class="glyph">
      <svg viewBox="0 0 32 32">
        <polygon points="16,3 28,9 28,23 16,29 4,23 4,9" fill="#55ffff" stroke="#000" stroke-width="1.5"></polygon>
        <polyline points="4,9 16,15 28,9" fill="none" stroke="#000" stroke-width="1.5"></polyline>
        <line x1="16" y1="15" x2="16" y2="29" stroke="#000" stroke-width="1.5"></line>
      </svg>
    </div>
    <span>3D Prints</span>
  </div>

  <div class="d-icon" data-open="term">
    <div class="glyph">
      <svg viewBox="0 0 32 32">
        <rect x="3" y="5" width="26" height="22" fill="#000" stroke="#000" stroke-width="1.5"></rect>
        <rect x="3" y="5" width="26" height="5" fill="#183661"></rect>
        <text x="6" y="20" fill="#33ff78" font-family="monospace" font-weight="bold" font-size="9">$ _</text>
      </svg>
    </div>
    <span>Links</span>
  </div>
</div>

<!-- Bottom-Right Secret Recipes Icon -->
<div class="d-icon secret-icon" data-open="recipes">
  <div class="glyph">
    <svg viewBox="0 0 32 32">
      <path d="M5 14h22l-2 13H7Z" fill="#ff9933" stroke="#000" stroke-width="1.5"></path>
      <line x1="3" y1="14" x2="29" y2="14" stroke="#000" stroke-width="2"></line>
      <path d="M11 10V5M16 10V5M21 10V5" stroke="#7cc4ff" stroke-width="1.5"></path>
    </svg>
  </div>
  <span>(Secret...Recipes)</span>
</div>
