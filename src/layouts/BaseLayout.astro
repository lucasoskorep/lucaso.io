---
import '../styles/syntax.css';
import '../styles/custom.css';

interface Props {
  title?: string;
  description?: string;
  isDesktop?: boolean;
  taskName?: string;
  counts?: {
    projects: number;
    blog: number;
    models: number;
  };
}

const {
  title = 'Lucas Oskorep',
  description = 'Software Engineer',
  isDesktop = false,
  taskName = 'Document',
  counts = { projects: 6, blog: 1, models: 3 },
} = Astro.props;

const pageTitle = title === 'Lucas Oskorep' ? 'Lucas Oskorep' : `${title} — Lucas Oskorep`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Umami Analytics -->
  <script defer src="https://umami.chaosdev.gay/script.js" data-website-id="432db62c-8e58-4e64-a298-275ecca8524c"></script>

  <!-- Dark Reader lock -->
  <meta name="darkreader-lock" />
  <meta name="color-scheme" content="dark" />

  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:type" content={isDesktop ? 'website' : 'article'} />
  <meta property="og:url" content={Astro.url} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />
</head>

<body class={isDesktop ? 'is-desktop' : 'is-workspace-2'} data-siteurl="">
  <!-- Animated Starfield Background -->
  <canvas class="desktop-canvas" id="demo-canvas"></canvas>

  <!-- Unified Top Panel -->
  <header class="top-panel">
    <span class="top-motto"><i>dEvOpS iS a mEaNiNgFuL tErM</i></span>
    <div class="panel-grip"></div>
    <button class="foot-btn pixel" id="startBtn" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="#7cc4ff">
        <ellipse cx="7" cy="6" rx="2" ry="2.6"></ellipse>
        <ellipse cx="12" cy="4.5" rx="1.8" ry="2.5"></ellipse>
        <ellipse cx="16.5" cy="5.5" rx="1.7" ry="2.2"></ellipse>
        <ellipse cx="20" cy="8.5" rx="1.5" ry="2"></ellipse>
        <path d="M12 9.5c-4.2 0-7 3-6.5 6.8.4 3 3.2 4.7 6 4.7 2.2 0 4.2-1.1 5-3 .6-1.4.2-2.6-.8-3.4-1-.8-1.5-1.6-.7-2.8.5-.8-.8-2.3-3-2.3z"></path>
      </svg>
      Apps
    </button>
    <div class="p-sep" id="pSepStart"></div>

    <!-- Workspace Pager -->
    <div class="ws-pager" id="wsPager" aria-label="Workspaces">
      {isDesktop ? (
        <span class="ws-btn on" title="Workspace 1 (Main Desktop)">1:Desktop</span>
        <a class="ws-btn" href="/pages/code-projects.html" id="ws2Link" title="Switch to Workspace 2 (Viewer)">2:Viewer</a>
      ) : (
        <a class="ws-btn" href="/" data-back-desktop title="Switch to Workspace 1 (Main Desktop)">1:Desktop</a>
        <span class="ws-btn on" title="Workspace 2 (Document Viewer)">2:Viewer</span>
      )}
    </div>
    <div class="p-sep" id="wsSep"></div>

    {!isDesktop && (
      <>
        <a class="p-btn" href="/" data-back-desktop>← Back to Desktop</a>
        <div class="p-sep" id="pSepBack"></div>
      </>
    )}

    <!-- Taskbar Window Buttons -->
    <div class="tasks" id="tasks">
      {!isDesktop && <span class="task on">{taskName}</span>}
    </div>

    <!-- Controls & Clock -->
    <div class="top-right">
      {isDesktop && (
        <button class="p-btn" id="btnArrange" type="button">⊞ Arrange Windows</button>
      )}
      <div class="clock mono" id="clock">12:00</div>
    </div>
  </header>

  <!-- Applications Menu (Start Menu) -->
  <div class="startmenu" id="startmenu">
    <div class="side">lucaso.io</div>
    <ul>
      <li data-open="about"><span>About Me</span><small>intro</small></li>
      <li data-open="projects"><span>Projects</span><small>{counts.projects}</small></li>
      <li data-open="blog"><span>Blog</span><small>{counts.blog}</small></li>
      <li data-open="models"><span>3D Prints</span><small>{counts.models}</small></li>
      <li data-open="term"><span>Links</span><small>sh</small></li>
    </ul>
  </div>

  <slot />

  <script src="../scripts/starfield.js"></script>
  <script src="../scripts/chrome.js"></script>
</body>
</html>
